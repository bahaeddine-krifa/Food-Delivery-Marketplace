# Food Delivery Platform - Environment Variables Example
# Copy this file to .env and fill in the values

# ============================================
# Application
# ============================================
SPRING_PROFILES_ACTIVE=docker

# ============================================
# Database (PostgreSQL)
# ============================================
DATABASE_URL=jdbc:postgresql://postgres:5432/food_delivery
DATABASE_USERNAME=food_delivery
DATABASE_PASSWORD=food_delivery

# ============================================
# Redis
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================
# Mail (MailHog for development)
# ============================================
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@fooddelivery.test

# ============================================
# JWT Configuration
# ============================================
# Must be at least 32 characters (256 bits) for HS512
JWT_SECRET=your-256-bit-secret-key-here-must-be-at-least-32-characters-long
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_REMEMBER_ME_EXPIRATION=30d
JWT_ISSUER=food-delivery-platform
JWT_AUDIENCE=food-delivery-clients

# ============================================
# File Upload
# ============================================
UPLOAD_PATH=/app/uploads
UPLOAD_MAX_SIZE=10MB
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ============================================
# Email Verification
# ============================================
EMAIL_VERIFICATION_BASE_URL=http://localhost:8080/api/v1/auth/verify-email
PASSWORD_RESET_BASE_URL=http://localhost:8080/api/v1/auth/reset-password

# ============================================
# Pagination
# ============================================
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=10
RATE_LIMIT_API_REQUESTS_PER_MINUTE=100

# ============================================
# Delivery Configuration
# ============================================
DELIVERY_DEFAULT_RADIUS_KM=5.0
DELIVERY_OFFER_TIMEOUT_SECONDS=60
DELIVERY_AUTO_ASSIGNMENT_ENABLED=true

# ============================================
# Order Configuration
# ============================================
ORDER_PENDING_TIMEOUT_MINUTES=10
ORDER_TAX_RATE=0.19

# ============================================
# Firebase Cloud Messaging (Optional)
# ============================================
# FCM_PROJECT_ID=your-fcm-project-id
# FCM_CREDENTIALS_PATH=/app/credentials/fcm-service-account.json

# ============================================
# MinIO (S3-compatible storage - Optional)
# ============================================
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=food-delivery

# ============================================
# Frontend URLs (for CORS)
# ============================================
FRONTEND_CLIENT_URL=http://localhost:3000
FRONTEND_RESTAURANT_URL=http://localhost:3001
FRONTEND_ADMIN_URL=http://localhost:3002
FRONTEND_DELIVERY_URL=http://localhost:3003